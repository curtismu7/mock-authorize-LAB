    {
      "name": "Worker token",
      "description": "The mock worker credentials, then the PingFederate-shaped token endpoint. The token is chained into the following folders via the WORKER_TOKEN collection variable.",
      "item": [
        {
          "name": "Mock worker credentials",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Mock worker credentials\", function () {",
                  "  pm.response.to.have.status(200);",
                  "  const b = pm.response.json(); pm.expect(b.clientId).to.be.a('string');",
                  "  pm.collectionVariables.set('WORKER_SECRET', b.clientSecret);",
                  "  pm.collectionVariables.set('BASIC_AUTH', Buffer.from(b.clientId + ':' + b.clientSecret).toString('base64'));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{LAB_BASE}}/api/worker",
              "host": [
                "{{LAB_BASE}}"
              ],
              "path": [
                "api",
                "worker"
              ]
            },
            "description": ""
          },
          "response": []
        },
        {
          "name": "Token (client_credentials, Basic auth)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Token (client_credentials, Basic auth)\", function () {",
                  "  pm.response.to.have.status(200);",
                  "  const b = pm.response.json(); pm.expect(b.access_token).to.be.a('string');",
                  "  pm.collectionVariables.set('WORKER_TOKEN', b.access_token);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Basic {{BASIC_AUTH}}"
              }
            ],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "grant_type",
                  "value": "client_credentials"
                }
              ]
            },
            "url": {
              "raw": "{{LAB_BASE}}/pingone/auth/{{ENV_ID}}/as/token",
              "host": [
                "{{LAB_BASE}}"
              ],
              "path": [
                "pingone",
                "auth",
                "{{ENV_ID}}",
                "as",
                "token"
              ]
            },
            "description": ""
          },
          "response": []
        },
        {
          "name": "Token with a wrong secret (negative)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Token with a wrong secret (negative)\", function () {",
                  "  pm.expect(pm.response.code).to.eql(401);",
                  "  pm.expect(pm.response.json().error).to.eql('invalid_client');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Basic bW9jay13b3JrZXI6d3Jvbmctc2VjcmV0"
              }
            ],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "grant_type",
                  "value": "client_credentials"
                }
              ]
            },
            "url": {
              "raw": "{{LAB_BASE}}/pingone/auth/{{ENV_ID}}/as/token",
              "host": [
                "{{LAB_BASE}}"
              ],
              "path": [
                "pingone",
                "auth",
                "{{ENV_ID}}",
                "as",
                "token"
              ]
            },
            "description": ""
          },
          "response": []
        }
      ]
    },
